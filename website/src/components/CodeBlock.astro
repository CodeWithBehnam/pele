---
import CopyButton from './CopyButton.astro';
import { highlightCode, type CodeLanguage } from '../lib/highlight';

interface Props {
  code: string;
  language: CodeLanguage;
  label?: string;
  showLineNumbers?: boolean;
}

const { code, language, label, showLineNumbers = false } = Astro.props;
const renderedCode = highlightCode(code, language, showLineNumbers);
// No `language-` class: Grammarly in Firefox runs Prism over every element it matches and leaves
// [object Object] where the code was. The language is in `data-language`.
---

<figure class:list={['doc-code', !label && 'doc-code-unlabeled', showLineNumbers && 'doc-code-numbered']} data-code-block>
  {label ? (
    <figcaption><span>{label}</span><span class="doc-code-actions"><CopyButton /></span></figcaption>
  ) : <span class="doc-code-actions"><CopyButton /></span>}
  <pre><code data-language={language} set:html={renderedCode} /></pre>
</figure>
